{
  "manifest_version": 3,
  "name": "Toolzology Extension 2",
  "description": "This is an official extension for toolzology.com for accessing our tools upgraded to manifest V3, fully secure, stable, and faster than ever before.",
  "version": "3.6",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "cookies",
    "notifications",
    "browsingData",
    "unlimitedStorage",
    "webRequest",
    "webNavigation",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "management"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "md.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "shh.js",
        "ab.js",
        "sd.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
